{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFTP Proxy configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostKeyFile"],
  "anyOf": [
    { "required": ["users"] },
    { "required": ["authBackend"] }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "Location of this schema for editor support."
    },
    "hostKeyFile": {
      "type": "string",
      "minLength": 1,
      "description": "PEM SSH host key used by the server."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 2222
    },
    "uploadStagingDir": {
      "type": "string",
      "minLength": 1,
      "default": "staging",
      "description": "Private directory used while SFTP uploads are in progress."
    },
    "loginGraceMs": {
      "type": "integer",
      "minimum": 0,
      "default": 120000,
      "description": "Milliseconds a connection may take to authenticate before it is disconnected, as in sshd_config LoginGraceTime. 0 means no limit."
    },
    "authBackend": { "$ref": "#/$defs/authBackend" },
    "users": {
      "type": "array",
      "items": { "$ref": "#/$defs/user" }
    }
  },
  "$defs": {
    "authBackend": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["baseURL"] },
        { "required": ["url"] }
      ],
      "properties": {
        "baseURL": {
          "type": "string",
          "format": "uri",
          "description": "Base URL for the multi-step authentication API."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Single endpoint for password authentication and filesystem setup."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "default": 30000,
          "description": "Milliseconds one HTTP request to the authentication backend may take. 0 means no limit."
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "rootfs"],
      "anyOf": [
        { "required": ["passwordHash"] },
        { "required": ["authorizedKeys"] }
      ],
      "properties": {
        "username": { "$ref": "#/$defs/name" },
        "passwordHash": {
          "type": "string",
          "minLength": 1,
          "description": "bcrypt password hash."
        },
        "authorizedKeys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "clientAliveMs": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Milliseconds an authenticated session may go unanswered before the server probes the client, as in sshd_config ClientAliveInterval. 0 disables probing."
        },
        "clientAliveCountMax": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Consecutive unanswered probes that end the connection, as in sshd_config ClientAliveCountMax. 0 never terminates on a missed probe."
        },
        "rootfs": { "$ref": "#/$defs/rootfs" }
      }
    },
    "rootfs": {
      "type": "object",
      "additionalProperties": false,
      "description": "The root directory node. Like any directory it may have a backend, its own allowed_methods, or statically configured children; a backend is what makes the root itself listable and writable.",
      "properties": {
        "backend": { "type": "string", "format": "uri" },
        "allowed_methods": { "$ref": "#/$defs/allowedMethods" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            { "required": ["directory"], "not": { "required": ["file"] } },
            { "required": ["file"], "not": { "required": ["directory"] } }
          ]
        },
        {
          "if": { "required": ["file"] },
          "then": {
            "required": ["backend"],
            "properties": { "children": { "maxItems": 0 } }
          }
        },
        {
          "if": { "required": ["directory"] },
          "then": {
            "anyOf": [
              { "required": ["backend"] },
              { "properties": { "children": { "minItems": 1 } }, "required": ["children"] }
            ]
          }
        }
      ],
      "properties": {
        "directory": { "$ref": "#/$defs/name" },
        "file": { "$ref": "#/$defs/name" },
        "backend": { "type": "string", "format": "uri" },
        "allowed_methods": { "$ref": "#/$defs/allowedMethods" },
        "size": { "type": "integer", "minimum": 0 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        },
        "maxUploadSize": { "type": "integer", "minimum": 0 },
        "maxConcurrentUploads": { "type": "integer", "minimum": 0 }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "allowedMethods": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["GET", "POST", "DELETE"] },
      "description": "HTTP methods the proxy may send to this node. Applies to that node alone and is never inherited by or from another. An omitted value allows all supported methods."
    }
  }
}